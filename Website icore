<script>
  document.getElementById('year').textContent = new Date().getFullYear();

  // Jagged "torn ticket" bottom edge, generated so it scales cleanly at any width.
  (function(){
    var el = document.querySelector('.ticket');
    if(!el) return;
    var teeth = 18;
    var points = ['0% 0%','100% 0%','100% 96%'];
    for(var i = teeth; i >= 0; i--){
      var x = (i / teeth) * 100;
      var y = i % 2 === 0 ? 100 : 94;
      points.push(x.toFixed(2) + '% ' + y + '%');
    }
    points.push('0% 96%');
    el.style.clipPath = 'polygon(' + points.join(',') + ')';
  })();
</script>

