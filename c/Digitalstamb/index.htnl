<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<meta name="theme-color" content="#111">
<title>Digital Stamb V2</title>

<style>
*{box-sizing:border-box;margin:0;padding:0}

body{
    font-family:Arial,Helvetica,sans-serif;
    background:#e9e9e9;
    color:#111;
}

button,input{
    font:inherit;
}

.app{
    width:100%;
    max-width:520px;
    min-height:100vh;
    margin:auto;
    background:#fff;
}

/* HEADER */

.header{
    background:#111;
    color:#fff;
    padding:22px 18px;
    display:flex;
    align-items:center;
    justify-content:space-between;
}

.brand{
    font-size:22px;
    font-weight:800;
    letter-spacing:1.5px;
}

.version{
    font-size:11px;
    color:#aaa;
}

/* TABS */

.tabs{
    display:grid;
    grid-template-columns:1fr 1fr;
    border-bottom:1px solid #ddd;
}

.tab{
    padding:15px 10px;
    border:0;
    background:#fff;
    cursor:pointer;
    font-weight:bold;
}

.tab.active{
    background:#111;
    color:#fff;
}

/* SECTIONS */

.section{
    display:none;
    padding:18px;
}

.section.active{
    display:block;
}

.title{
    font-size:23px;
    font-weight:800;
    margin-bottom:5px;
}

.subtitle{
    color:#777;
    font-size:13px;
    margin-bottom:20px;
}

/* FORM */

.form-group{
    margin-bottom:14px;
}

label{
    display:block;
    font-size:13px;
    font-weight:bold;
    margin-bottom:6px;
}

input{
    width:100%;
    padding:13px;
    border:1px solid #ccc;
    border-radius:11px;
    outline:none;
}

input:focus{
    border-color:#111;
}

.primary{
    width:100%;
    padding:14px;
    border:0;
    border-radius:12px;
    background:#111;
    color:#fff;
    font-weight:bold;
    cursor:pointer;
}

/* ID */

.id-box{
    background:#f2f2f2;
    padding:15px;
    border-radius:12px;
    margin-bottom:18px;
}

.id-label{
    font-size:11px;
    color:#777;
}

.id-value{
    font-size:22px;
    font-weight:800;
    margin-top:4px;
}

/* BUSINESS LIST */

.business-card{
    border:1px solid #ddd;
    border-radius:15px;
    padding:15px;
    margin-bottom:12px;
}

.business-top{
    display:flex;
    justify-content:space-between;
    align-items:center;
}

.business-name{
    font-weight:800;
    font-size:17px;
}

.stamb-id{
    font-size:11px;
    color:#777;
    margin-top:4px;
}

.card-buttons{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:8px;
    margin-top:13px;
}

.small-btn{
    border:0;
    padding:10px;
    border-radius:9px;
    cursor:pointer;
    background:#eee;
    font-size:12px;
    font-weight:bold;
}

.small-btn.dark{
    background:#111;
    color:#fff;
}

.small-btn.delete{
    background:#ffe2e2;
}

/* PROFILE */

.profile-page{
    text-align:center;
}

.profile-header{
    background:#111;
    color:#fff;
    padding:25px 15px;
    border-radius:15px;
}

.profile-logo{
    width:75px;
    height:75px;
    border-radius:50%;
    background:#fff;
    color:#111;
    display:flex;
    align-items:center;
    justify-content:center;
    margin:auto;
    font-size:25px;
    font-weight:800;
}

.profile-header h2{
    margin-top:12px;
}

.profile-header p{
    color:#aaa;
    font-size:13px;
    margin-top:5px;
}

.profile-location{
    margin-top:7px;
    color:#ccc;
    font-size:12px;
}

.actions{
    margin-top:15px;
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:10px;
}

.action{
    padding:14px 8px;
    border-radius:12px;
    text-decoration:none;
    color:#111;
    background:#eee;
    font-size:13px;
    font-weight:bold;
}

.whatsapp{
    background:#25D366;
    color:#fff;
}

.call{
    background:#111;
    color:#fff;
}

.review{
    background:#fff0b8;
}

.about{
    margin-top:15px;
    padding:17px;
    background:#f5f5f5;
    border-radius:13px;
    text-align:left;
}

.about h3{
    margin-bottom:8px;
}

.about p{
    color:#666;
    font-size:13px;
    line-height:1.6;
}

/* QR */

.qr-box{
    margin-top:15px;
    padding:18px;
    border:1px solid #ddd;
    border-radius:15px;
    text-align:center;
}

.qr-box img{
    width:190px;
    height:190px;
    margin:15px auto;
    display:block;
}

.qr-url{
    word-break:break-all;
    font-size:11px;
    color:#777;
}

/* ANALYTICS */

.stats{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:10px;
}

.stat{
    background:#111;
    color:#fff;
    border-radius:13px;
    padding:18px;
}

.stat-number{
    font-size:26px;
    font-weight:800;
}

.stat-label{
    font-size:11px;
    color:#aaa;
    margin-top:4px;
}

/* EMPTY */

.empty{
    text-align:center;
    padding:30px 10px;
    color:#777;
    font-size:14px;
}

.notice{
    padding:12px;
    background:#fff7d6;
    border-radius:10px;
    font-size:12px;
    color:#555;
    margin-bottom:15px;
}
</style>
</head>

<body>

<div class="app">

<header class="header">
    <div class="brand">DIGITAL STAMB</div>
    <div class="version">V2.0</div>
</header>

<div class="tabs">
    <button class="tab active" onclick="showTab('admin',this)">
        ⚙️ Admin
    </button>

    <button class="tab" onclick="showTab('profile',this)">
        📱 Profile
    </button>
</div>


<!-- ================= ADMIN ================= -->

<section id="admin" class="section active">

    <div class="title">Admin Panel</div>

    <div class="subtitle">
        Create and manage Digital Stamb profiles
    </div>

    <div class="notice">
        Demo version: data is stored locally in this browser.
    </div>

    <div class="id-box">

        <div class="id-label">
            NEXT DIGITAL STAMB ID
        </div>

        <div class="id-value" id="nextId">
            DS-000001
        </div>

    </div>


    <div class="form-group">
        <label>Business Name</label>
        <input
            id="businessName"
            placeholder="Example: Atlas Mobiles"
        >
    </div>


    <div class="form-group">
        <label>Category</label>
        <input
            id="category"
            placeholder="Mobile Store"
        >
    </div>


    <div class="form-group">
        <label>Location</label>
        <input
            id="location"
            placeholder="Thodupuzha, Kerala"
        >
    </div>


    <div class="form-group">
        <label>Phone Number</label>
        <input
            id="phone"
            placeholder="917907930656"
            inputmode="tel"
        >
    </div>


    <div class="form-group">
        <label>WhatsApp Number</label>
        <input
            id="whatsapp"
            placeholder="917907930656"
            inputmode="tel"
        >
    </div>


    <div class="form-group">
        <label>Instagram URL</label>
        <input
            id="instagram"
            placeholder="https://instagram.com/yourpage"
        >
    </div>


    <div class="form-group">
        <label>Google Review URL</label>
        <input
            id="review"
            placeholder="https://search.google.com/local/writereview..."
        >
    </div>


    <div class="form-group">
        <label>Google Maps URL</label>
        <input
            id="maps"
            placeholder="https://maps.google.com/..."
        >
    </div>


    <div class="form-group">
        <label>Website URL</label>
        <input
            id="website"
            placeholder="https://example.com"
        >
    </div>


    <div class="form-group">
        <label>About Business</label>
        <input
            id="about"
            placeholder="Short description..."
        >
    </div>


    <button class="primary" onclick="createBusiness()">
        ➕ Create Digital Stamb
    </button>


    <br><br>

    <h3 style="margin-bottom:12px">
        Your Digital Stambs
    </h3>

    <div id="businessList"></div>

</section>



<!-- ================= PROFILE ================= -->

<section id="profile" class="section">

    <div class="title">Customer Profile</div>

    <div class="subtitle">
        Preview the selected Digital Stamb
    </div>

    <div id="profileContent">

        <div class="empty">
            Create a Digital Stamb from the Admin panel first.
        </div>

    </div>

</section>

</div>



<script>

/* ==========================================
   DATA
========================================== */

let businesses =
    JSON.parse(
        localStorage.getItem("digitalStambBusinesses")
    ) || [];

let selectedId =
    localStorage.getItem("selectedStamb");


/* ==========================================
   TAB
========================================== */

function showTab(id,button){

    document
        .querySelectorAll(".section")
        .forEach(x => x.classList.remove("active"));

    document
        .getElementById(id)
        .classList.add("active");

    document
        .querySelectorAll(".tab")
        .forEach(x => x.classList.remove("active"));

    button.classList.add("active");

    if(id === "profile"){
        renderProfile();
    }
}


/* ==========================================
   ID GENERATOR
========================================== */

function getNextId(){

    if(businesses.length === 0){
        return "DS-000001";
    }

    let max = 0;

    businesses.forEach(b => {

        let n =
            parseInt(
                b.id.replace("DS-","")
            );

        if(n > max) max = n;

    });

    return "DS-" +
        String(max + 1).padStart(6,"0");
}


document.getElementById("nextId").innerText =
    getNextId();


/* ==========================================
   CREATE
========================================== */

function createBusiness(){

    let name =
        document.getElementById("businessName")
        .value.trim();

    if(!name){

        alert("Please enter business name.");

        return;
    }

    let business = {

        id:getNextId(),

        name:name,

        category:
            document.getElementById("category").value
            || "Business",

        location:
            document.getElementById("location").value
            || "",

        phone:
            document.getElementById("phone").value
            || "",

        whatsapp:
            document.getElementById("whatsapp").value
            || "",

        instagram:
            document.getElementById("instagram").value
            || "",

        review:
            document.getElementById("review").value
            || "",

        maps:
            document.getElementById("maps").value
            || "",

        website:
            document.getElementById("website").value
            || "",

        about:
            document.getElementById("about").value
            || "",

        visits:0,

        clicks:{
            whatsapp:0,
            call:0,
            review:0,
            instagram:0,
            maps:0,
            website:0
        }

    };


    businesses.push(business);

    saveData();

    selectedId = business.id;

    localStorage.setItem(
        "selectedStamb",
        selectedId
    );


    clearForm();

    renderBusinesses();

    document.getElementById("nextId").innerText =
        getNextId();

    alert(
        "Digital Stamb created!\n\n" +
        business.id
    );

}


/* ==========================================
   SAVE
========================================== */

function saveData(){

    localStorage.setItem(
        "digitalStambBusinesses",
        JSON.stringify(businesses)
    );

}


/* ==========================================
   CLEAR FORM
========================================== */

function clearForm(){

    document
        .querySelectorAll("input")
        .forEach(x => x.value = "");

}


/* ==========================================
   BUSINESS LIST
========================================== */

function renderBusinesses(){

    let box =
        document.getElementById("businessList");

    if(businesses.length === 0){

        box.innerHTML =
            '<div class="empty">No Digital Stamb created yet.</div>';

        return;
    }


    box.innerHTML =
        businesses.map(b => `

        <div class="business-card">

            <div class="business-top">

                <div>
                    <div class="business-name">
                        ${escapeHtml(b.name)}
                    </div>

                    <div class="stamb-id">
                        ${b.id}
                    </div>
                </div>

                <div>
                    👁️ ${b.visits}
                </div>

            </div>


            <div class="card-buttons">

                <button
                    class="small-btn dark"
                    onclick="openProfile('${b.id}')">
                    📱 Open
                </button>

                <button
                    class="small-btn"
                    onclick="showQR('${b.id}')">
                    🔳 QR
                </button>

                <button
                    class="small-btn"
                    onclick="showAnalytics('${b.id}')">
                    📊 Analytics
                </button>

                <button
                    class="small-btn delete"
                    onclick="deleteBusiness('${b.id}')">
                    🗑 Delete
                </button>

            </div>

        </div>

    `).join("");

}


/* ==========================================
   OPEN PROFILE
========================================== */

function openProfile(id){

    selectedId = id;

    localStorage.setItem(
        "selectedStamb",
        id
    );


    document
        .querySelectorAll(".section")
        .forEach(x =>
            x.classList.remove("active")
        );

    document
        .getElementById("profile")
        .classList.add("active");


    document
        .querySelectorAll(".tab")
        .forEach(x =>
            x.classList.remove("active")
        );

    document
        .querySelectorAll(".tab")[1]
        .classList.add("active");


    renderProfile();

}


/* ==========================================
   PROFILE
========================================== */

function renderProfile(){

    let b =
        businesses.find(x => x.id === selectedId);


    if(!b){

        document.getElementById("profileContent")
        .innerHTML =
        '<div class="empty">Select a Digital Stamb.</div>';

        return;
    }


    b.visits++;

    saveData();


    let initials =
        b.name
        .split(" ")
        .slice(0,2)
        .map(x => x[0])
        .join("")
        .toUpperCase();


    let html = `

        <div class="profile-page">

            <div class="profile-header">

                <div class="profile-logo">
                    ${escapeHtml(initials)}
                </div>

                <h2>
                    ${escapeHtml(b.name)}
                </h2>

                <p>
                    ${escapeHtml(b.category)}
                </p>

                <div class="profile-location">
                    📍 ${escapeHtml(b.location)}
                </div>

            </div>


            <div class="actions">

                <a
                    class="action whatsapp"
                    href="${safeUrl(
                        "https://wa.me/" + cleanPhone(b.whatsapp)
                    )}"
                    target="_blank"
                    onclick="clickTrack('whatsapp')">
                    💬 WhatsApp
                </a>


                <a
                    class="action call"
                    href="${safeUrl(
                        "tel:" + cleanPhone(b.phone)
                    )}"
                    onclick="clickTrack('call')">
                    📞 Call
                </a>


                <a
                    class="action review"
                    href="${safeUrl(b.review)}"
                    target="_blank"
                    onclick="clickTrack('review')">
                    ⭐ Google Review
                </a>


                <a
                    class="action"
                    href="${safeUrl(b.instagram)}"
                    target="_blank"
                    onclick="clickTrack('instagram')">
                    📸 Instagram
                </a>


                <a
                    class="action"
                    href="${safeUrl(b.maps)}"
                    target="_blank"
                    onclick="clickTrack('maps')">
                    📍 Maps
                </a>


                <a
                    class="action"
                    href="${safeUrl(b.website)}"
                    target="_blank"
                    onclick="clickTrack('website')">
                    🌐 Website
                </a>

            </div>


            <div class="about">

                <h3>About</h3>

                <p>
                    ${escapeHtml(
                        b.about ||
                        "Welcome to our business."
                    )}
                </p>

            </div>


            <div class="qr-box">

                <strong>
                    Scan / Share Digital Stamb
                </strong>

                <img
                    src="https://api.qrserver.com/v1/create-qr-code/?size=300x300&data=${encodeURIComponent(
                        getStambUrl(b.id)
                    )}"
                    alt="QR Code">

                <div class="qr-url">
                    ${escapeHtml(getStambUrl(b.id))}
                </div>

            </div>

        </div>
    `;


    document.getElementById("profileContent")
        .innerHTML = html;

}


/* ==========================================
   QR
========================================== */

function showQR(id){

    let b =
        businesses.find(x => x.id === id);

    if(!b) return;

    let url =
        getStambUrl(b.id);


    alert(
        "Stamb ID: " + b.id +
        "\n\nURL:\n" + url +
        "\n\nThe QR is displayed in the Profile tab."
    );


    openProfile(id);

}


/* ==========================================
   URL
========================================== */

function getStambUrl(id){

    /*
       When you upload this to your real domain,
       replace this URL with your domain structure.

       Example:
       https://yourdomain.com/stamb/DS-000001
    */

    return location.origin +
        location.pathname +
        "?stamb=" +
        encodeURIComponent(id);

}


/* ==========================================
   ANALYTICS
========================================== */

function showAnalytics(id){

    let b =
        businesses.find(x => x.id === id);

    if(!b) return;


    let c = b.clicks || {};


    alert(
        "📊 " + b.name +
        "\n\n" +

        "Stamb: " + b.id +
        "\n" +

        "Visits: " + b.visits +
        "\n\n" +

        "WhatsApp: " + (c.whatsapp || 0) +
        "\n" +

        "Call: " + (c.call || 0) +
        "\n" +

        "Google Review: " + (c.review || 0) +
        "\n" +

        "Instagram: " + (c.instagram || 0) +
        "\n" +

        "Maps: " + (c.maps || 0) +
        "\n" +

        "Website: " + (c.website || 0)
    );

}


/* ==========================================
   CLICK TRACKING
========================================== */

function clickTrack(type){

    let b =
        businesses.find(x => x.id === selectedId);

    if(!b) return;


    if(!b.clicks){

        b.clicks = {};

    }


    b.clicks[type] =
        (b.clicks[type] || 0) + 1;


    saveData();

}


/* ==========================================
   DELETE
========================================== */

function deleteBusiness(id){

    if(!confirm(
        "Delete this Digital Stamb?"
    )) return;


    businesses =
        businesses.filter(
            b => b.id !== id
        );


    saveData();

    renderBusinesses();

    document.getElementById("nextId").innerText =
        getNextId();

}


/* ==========================================
   PHONE
========================================== */

function cleanPhone(phone){

    return String(phone || "")
        .replace(/\D/g,"");

}


/* ==========================================
   URL SAFETY
========================================== */

function safeUrl(url){

    if(!url) return "#";

    return url;

}


/* ==========================================
   HTML ESCAPE
========================================== */

function escapeHtml(value){

    return String(value || "")
        .replace(/&/g,"&amp;")
        .replace(/</g,"&lt;")
        .replace(/>/g,"&gt;")
        .replace(/"/g,"&quot;")
        .replace(/'/g,"&#039;");

}


/* ==========================================
   AUTO OPEN STAMB
========================================== */

function loadFromUrl(){

    let params =
        new URLSearchParams(
            location.search
        );

    let id =
        params.get("stamb");


    if(id){

        let exists =
            businesses.some(
                b => b.id === id
            );

        if(exists){

            selectedId = id;

            openProfile(id);

        }

    }

}


/* ==========================================
   START
========================================== */

renderBusinesses();

document.getElementById("nextId").innerText =
    getNextId();

loadFromUrl();

</script>

</body>
</html>
