      font-size: 35px;
      margin-bottom: 12px;
    }

    .cta p {
      color: #dbeafe;
      margin-bottom: 25px;
    }

    .cta a {
      display: inline-block;
      text-decoration: none;
      padding: 14px 25px;
      border-radius: 10px;
      font-weight: bold;
      margin: 5px;
